@page "/"
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>
<h1 class="text-center mb-5">Hello and welcome to my portfolio</h1>
<div class="d-flex flex-column align-items-center justify-content-center mt-5">
    <p class="text-light mb-5">
        On this site you can see my various projects and my skills.
    </p>
    <div class="d-flex flex-column flex-md-row align-items-center mt-5 gap-5">
        <div class="d-flex flex-column align-items-center justify-content-center">
            <h2>Projects</h2>
            <img src="images/ProjectsImage.jpg" alt="Projects" class="w-75" />
            <button type="button" class="important-button w-auto p-2 mt-1"
                    @onclick='() => Navigation.NavigateTo("/projects")'>
                See my projects
            </button>
        </div>
        <div class="d-flex flex-column align-items-center justify-content-center">
            <h2>Skills</h2>
            <img src="images/SkillsImage.jpg" alt="Skills" class="w-75" />
            <button type="button" class="important-button w-auto p-2 mt-1"
                    @onclick='() => Navigation.NavigateTo("/skills")'>
                See my skills
            </button>
        </div>
    </div>
</div>

@code {

}