@page "/skills"
@using MyPortfolio.DataPopulation
@using MyPortfolio.Models
@inject NavigationManager Navigation
<h3>Skills</h3>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    @foreach (var skill in _skills)
    {
        <div class="col d-flex">
            <div class="grid-item generic-text text-center text-lg-start h-100 w-100 d-flex flex-column generic-card">
                <h4>@skill.Name</h4>
                <p>Level: @skill.Proficiency</p>
                @foreach (var project in skill.RelatedProjects)
                {
                    <p>
                        <button class="generic-button"
                                @onclick="@(() => Navigation.NavigateTo($"projects/{project.Slug}"))">
                            @project.Title
                        </button>
                    </p>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Skill> _skills = ProjectsAndSkills.Skills;
}
